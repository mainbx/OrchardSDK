{
  "name": "orchardsdk",
  "version": "0.1.0",
  "description": "Transport-agnostic SDK for trusted communication between AI agents and humans.",
  "type": "module",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./integrations/email": {
      "types": "./dist/integrations/email/index.d.ts",
      "import": "./dist/integrations/email/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/phase1.ts"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
